+import hashlib, json, unicodedata
+from decimal import Decimal
+
+def _normalize(value):
+    if value is None or isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        return unicodedata.normalize("NFC", value)
+    if isinstance(value, (int, float, Decimal)):
+        number = Decimal(str(value))
+        if not number.is_finite():
+            raise ValueError("finite JSON number required")
+        number = Decimal(0) if number == 0 else number.normalize()
+        return {"$number": format(number, "f")}
+    if isinstance(value, list):
+        return [_normalize(item) for item in value]
+    if isinstance(value, dict) and all(isinstance(key, str) for key in value):
+        normalized = {}
+        for key, item in value.items():
+            key = unicodedata.normalize("NFC", key)
+            if key in normalized:
+                raise ValueError("duplicate normalized JSON key")
+            normalized[key] = _normalize(item)
+        return {key: normalized[key] for key in sorted(normalized)}
+    raise ValueError("JSON-compatible substantive parameters required")
+
+# The MCP boundary must reject duplicate keys while parsing raw tool arguments;
+# a dict has already lost the information needed to distinguish them.
+
+def parameters_hash(parameters):
+    raw = json.dumps(_normalize(parameters), sort_keys=True, separators=(",", ":"),
+                     ensure_ascii=True, allow_nan=False).encode("ascii")
+    return hashlib.sha256(raw).hexdigest()
+
+def commitment_hash(*, operation_type, parameters, subject, commitment_version=2):
+    if commitment_version != 2 or not operation_type or not subject:
+        raise ValueError("invalid v2 commitment scope")
+    body = {"commitment_version": 2, "operation_type": operation_type,
+            "substantive_parameters_hash": parameters_hash(parameters),
+            "subject": subject}
+    raw = json.dumps(body, sort_keys=True, separators=(",", ":"),
+                     ensure_ascii=True).encode("ascii")
+    return hashlib.sha256(raw).hexdigest()
